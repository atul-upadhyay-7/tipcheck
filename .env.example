# Backend (read from the environment; nothing is required for local dev)
# Comma-separated origins allowed to call the API directly. Empty = no CORS (dev uses the Vite /api proxy).
TIPCHECK_CORS_ORIGINS=
# Override the trained model location (default: backend/ml/model.joblib)
TIPCHECK_MODEL_PATH=

# Frontend (put in frontend/.env.local)
# Where the Vite dev server proxies /api (default http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Absolute API URL for production builds (default /api)
VITE_API_BASE_URL=

# Optional frontend build location served by FastAPI; leave unset for frontend/dist
# TIPCHECK_FRONTEND_DIST=
